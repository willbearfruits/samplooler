# Shared by both targets. Target-specific settings live in sdkconfig.defaults.esp32s3 / .esp32c3.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Console over the native USB Serial/JTAG on both chips, so `idf.py monitor` just works.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# 1 ms tick so the 10 ms input poll is exact.
CONFIG_FREERTOS_HZ=1000

# Sample slots live in a FAT partition (partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FATFS_LFN_HEAP=y

# Production: the I2S ISR and its overflow callbacks stay in IRAM (they run while flash is being written),
# a task that hangs for 5 s resets the device instead of just logging (diag.c then reports WATCHDOG), and
# the main task gets room for FATFS, NVS and printf with floats on top of the UI.
CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
