# ESP32-S3 SuperMini (ESP32-S3FH4R2: 2 MB embedded quad PSRAM holds the 20 s take)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# USB composite: CDC console + MIDI + UAC2 sound card (2 in, 2 out, 32 kHz, 16-bit).
# Descriptors and tusb_config.h are ours (main/usb/), the UAC component is a part.
CONFIG_USB_DEVICE_UAC_AS_PART=y
CONFIG_UAC_SAMPLE_RATE=32000
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_SUPPORT_MACOS=y
CONFIG_UAC_TINYUSB_TASK_CORE=0
CONFIG_UAC_SPK_TASK_CORE=0
CONFIG_UAC_MIC_TASK_CORE=0
