# Generated by tools/iram_lf.py from the audio path's entry points: voice:vox_run
# 11 functions (42206 bytes of code to IRAM), 1 tables (28 bytes to DRAM); functions marked
# IRAM_ATTR are there already. Rebuild, then run it again after changing what the sound calls.
[mapping:samplooler_voice]
archive: libmain.a
entries:
    sing_fx:vfx_bus (noflash)
    sing_fx:vfx_input (noflash)
    sing_vocoder:design (noflash)
    sing_vocoder:osc_block (noflash)
    sing_vocoder:vocoder_process (noflash)
    sing_voice:add_grain (noflash)
    sing_voice:push_mark (noflash)
    sing_voice:render (noflash)
    sing_voice:schedule (noflash)
    sing_voice:tracker_frame (noflash)
    sing_voice:voice_process (noflash)
