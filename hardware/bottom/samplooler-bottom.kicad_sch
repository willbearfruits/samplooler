	(text "USB-C on the SuperMini powers everything: its 5V pin feeds the DAC (and amp),\nits 3.3 V regulator feeds the mic, IMU, joystick, OLED and encoder."
		(exclude_from_sim no)
		(at 20 125 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "baf498f2-077b-5d4c-b65b-c039b5d3333d")
	)
	(text "JP1-JP4 stand in for the H1L-H4L bridges on the back of the\nDAC board, out of reach once it is mounted. Leave them OPEN\nif those bridges are set. Otherwise bridge FLT=L, DEMP=L,\nXSMT=H (unmute), FMT=L.  H is DAC_3V3, the module's own\n3.3 V regulator output, never the board 3V3."
		(exclude_from_sim no)
		(at 155 110 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "eb43c6a3-c1c6-5e7d-8905-94323eca32c3")
	)
	(text "Sound hole UP: the metal can faces the carrier.\nL/R to GND: data in the left slot."
		(exclude_from_sim no)
		(at 305 68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4adf2172-57ef-5aa1-b654-44fa2e309d90")
	)
	(text "AD0 to GND: address 0x68.  The chip's +X axis points\nto the nose (the USB / jack edge)."
		(exclude_from_sim no)
		(at 305 145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "79e68ab5-a9b0-580f-aa8a-c7b336fef4be")
	)
	(text "The \"+5V\" pin goes to 3V3: the ESP32 ADC\nreads 0-3.3 V.  SW uses the internal pull-up."
		(exclude_from_sim no)
		(at 20 190 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c5247b39-59e1-5ce7-aca0-a2a91148cfde")
	)
	(text "GAIN floating = 9 dB.  SD (GPIO11) low = amp off.\nVIN from USB 5V."
		(exclude_from_sim no)
		(at 155 192 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1530cb87-209e-599a-b78d-d8463bd878b6")
	)
	(text "R1, R2 not fitted: the OLED and GY-521 boards carry\nI2C pull-ups. Fit them only if neither does."
		(exclude_from_sim no)
		(at 155 258 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "70c07a44-976d-59ae-aafc-3cf73d53a950")
	)
	(text "Holes tie both boards' ground pours\nthrough metal standoffs."
		(exclude_from_sim no)
		(at 305 205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2e415751-f05a-5684-b61c-75765650a36c")
	)
	(text "Stack: bottom board, 11 mm M3 standoffs,\ntop board. The 2x4 socket (8.5 mm) and the\ntop board's header (2.5 mm plastic) mate at\nexactly that height."
		(exclude_from_sim no)
		(at 305 225 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "148d09cf-56fc-5d52-aa41-6249177366d7")
	)
	(sheet_instances
		(path "/"
			(page "1")
		)
	)
	(embedded_fonts no)
