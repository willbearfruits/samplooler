			(uuid "1cd0a2a6-8a44-5aac-90b9-0f7dedae87ed")
		)
		(instances
			(project "samplooler-stack-bottom"
				(path "/92adf059-b385-52ab-b660-b248498ba6a5"
					(reference "#FLG54")
					(unit 1)
				)
			)
		)
	)
	(text "USB-C on the SuperMini powers everything: its 5V pin feeds the DAC and the amp, its 3.3 V\nregulator feeds the IMU, joystick, top board (OLED, mic), Qwiic and the breakouts."
		(exclude_from_sim no)
		(at 20 253.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "90c0ddae-4ac9-5c64-81a9-eb34b636eb4d")
	)
	(text "DAC control pins are tied here, no straps: FLT, DEMP, FMT to GND (normal filter, no de-emphasis,\nI2S), XSMT to A3V3, the module's own 3.3 V (unmuted). A floating FMT distorts at a touch.\nMatches the H1L-H4L bridges on the DAC board's back if they are set as usual (L L H L)."
		(exclude_from_sim no)
		(at 20 260.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6f71d8ed-4991-5934-8b0e-6034865a2b27")
	)
	(text "Joystick pots run from 3V3 (not 5V): the ESP32 ADC reads 0-3.3 V. The IMU's +X axis points at\nthe nose (the USB / jack edge). AD0 to GND: address 0x68."
		(exclude_from_sim no)
		(at 20 270.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ad0dc786-6f66-57d1-9939-71b89efa2c1f")
	)
	(text "EXP A / EXP B carry every GPIO the design leaves free, including the SuperMini's underside pads\n(reached with pogo pins). 45 and 46 are strapping pins; 48 drives the module's RGB LED."
		(exclude_from_sim no)
		(at 20 277.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f21f8c0a-44c1-5790-9a63-115ddf4d3fca")
	)
	(text "R1, R2 are not fitted: the OLED and GY-521 boards carry I2C pull-ups."
		(exclude_from_sim no)
		(at 20 284.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "604647df-00aa-5c4b-ae49-b75d30249fa2")
	)
