# ESP-IDF build output and generated configs
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock
plugin/build/
plugin/build.log
plugin/build-configure.log
# release images made by tools/release.sh
dist/
__pycache__/
# the Pages job puts the images and the video next to the page
site/firmware/*.bin
site/media/
# KiCad's per-user state, if you open the boards
hardware/*/*.kicad_prl
hardware/*/fp-info-cache
hardware/*/*-backups/
hardware/*/~*.lck
hardware/*/_autosave-*

# instruments: each entry's own build output (also in the entries' .gitignore)
instruments/*/firmware/build/
instruments/*/firmware/sdkconfig
instruments/*/firmware/sdkconfig.old
instruments/*/firmware/managed_components/
instruments/*/tools/sim/obj/
instruments/*/tools/sim/sim
instruments/*/tools/sim/out/
