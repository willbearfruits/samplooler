# ESP-IDF build output and generated configs
firmware/build/
firmware/build-c3/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig.c3
firmware/sdkconfig.c3.old
firmware/managed_components/
firmware/dependencies.lock
# printable meshes are regenerated by enclosure/render.sh; keep the previews
enclosure/out/*.stl
plugin/build/
plugin/build.log
plugin/build-configure.log
# release images made by tools/release.sh
dist/
__pycache__/
# the Pages job puts the images and the video next to the page
site/firmware/*.bin
site/media/
# hardware/gen scratch: router round trip, render stack, KiCad per-user state
hardware/*/route.dsn
hardware/*/route.ses
hardware/*/freerouting.log
hardware/*/*.kicad_prl
hardware/*/fp-info-cache
hardware/*/*-backups/
hardware/.stack/
hardware/fab/*-gerbers/
hardware/*/*.net
hardware/*/~*.lck
hardware/*/_autosave-*
