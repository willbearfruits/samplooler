# Generated by tools/iram_lf.py from the audio path's entry points: instrument:audio
# 7 functions (8083 bytes of code to IRAM), 0 tables (0 bytes to DRAM); functions marked
# IRAM_ATTR are there already. Rebuild, then run it again after changing what the sound calls.
[mapping:sift_audio]
archive: libmain.a
entries:
    audio:audio_frames (noflash)
    inst_engine:eng_audio (noflash)
    inst_engine:grid_at (noflash)
    inst_engine:spawn (noflash)
    instrument:audio (noflash)
    link:link_fpb (noflash)
    link:link_origin (noflash)
