# Generated by tools/iram_lf.py from the audio path's entry points: instrument:audio
# 10 functions (8572 bytes of code to IRAM), 2 tables (32 bytes to DRAM); functions marked
# IRAM_ATTR are there already. Rebuild, then run it again after changing what the sound calls.
[mapping:nylon_audio]
archive: libmain.a
entries:
    audio:audio_frames (noflash)
    inst_fx:echo_clear_step (noflash)
    inst_fx:echo_reset (noflash)
    inst_fx:room_run (noflash)
    inst_grain:bloom_clear (noflash)
    inst_grain:bloom_onset (noflash)
    inst_loop:close_take (noflash)
    inst_loop:loop_process (noflash)
    instrument:audio (noflash)
