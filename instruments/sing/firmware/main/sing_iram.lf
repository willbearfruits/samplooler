# Generated by tools/iram_lf.py from the audio path's entry points: instrument:audio inst_voice:voice_process inst_vocoder:vocoder_process inst_fx:fx_input inst_fx:fx_bus inst_looper:loop_run inst_looper:loop_stutter front:front_audio
# 18 functions (52074 bytes of code to IRAM), 1 tables (28 bytes to DRAM); functions marked
# IRAM_ATTR are there already. Rebuild, then run it again after changing what the sound calls.
[mapping:sing_audio]
archive: libmain.a
entries:
    audio:audio_frames (noflash)
    inst_fx:fx_bus (noflash)
    inst_fx:fx_input (noflash)
    inst_looper:begin_take (noflash)
    inst_looper:grain_start (noflash)
    inst_looper:loop_run (noflash)
    inst_looper:loop_stutter (noflash)
    inst_vocoder:design (noflash)
    inst_vocoder:osc_block (noflash)
    inst_vocoder:vocoder_process (noflash)
    inst_voice:add_grain (noflash)
    inst_voice:push_mark (noflash)
    inst_voice:render (noflash)
    inst_voice:schedule (noflash)
    inst_voice:tracker_frame (noflash)
    inst_voice:voice_process (noflash)
    instrument:audio (noflash)
    looper:looper_process (noflash)
