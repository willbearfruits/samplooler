    inst_bowl:bowl_process (noflash)
    inst_bowl:run (noflash)
    inst_drone:dr_process (noflash)
    inst_drone:drone_on (noflash)
    inst_drone:flags (noflash)
    inst_drone:hit (noflash)
    inst_drone:latch (noflash)
    inst_drone:organ_chord (noflash)
    inst_drone:take_now (noflash)
    inst_fx:fx_bus (noflash)
    inst_fx:fx_input (noflash)
    inst_score:sc_mode (noflash)
    inst_voice:hpc_run (noflash)
    inst_voice:hpc_set (noflash)
    inst_voice:jaw_target (noflash)
    inst_voice:mv_effect (noflash)
    inst_voice:mv_process (noflash)
    inst_voice:ph_target (noflash)
    inst_voice:segment (noflash)
    inst_voice:tract_design (noflash)
    instrument:audio (noflash)
    instrument:host_degree_at (noflash)
    looper:looper_process (noflash)
    inst_drone:change_bars (noflash)
    inst_drone:dark_scale (noflash)
    inst_drone:mrate_beats (noflash)
