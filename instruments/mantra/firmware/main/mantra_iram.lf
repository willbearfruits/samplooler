    inst_voice:FT (noflash)
    inst_voice:PT (noflash)
    inst_voice:pers_cents (noflash)
    inst_voice:pers_onset (noflash)
    inst_voice:pers_tract (noflash)
    inst_voice:pers_vib (noflash)
    instrument:bar_beats (noflash)
    instrument:progs (noflash)
