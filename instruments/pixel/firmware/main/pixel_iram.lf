# Generated by tools/iram_lf.py from the audio path's entry points: instrument:audio front:front_audio inst_con_ref:render
# 7 functions (5613 bytes of code to IRAM), 3 tables (244 bytes to DRAM); functions marked
# IRAM_ATTR are there already. Rebuild, then run it again after changing what the sound calls.
[mapping:pixel_audio]
archive: libmain.a
entries:
    audio:audio_frames (noflash)
    inst_player:mono_tick (noflash)
    inst_player:px_player_restart (noflash)
    inst_player:px_player_tick (noflash)
    inst_song:px_chord_notes (noflash)
    looper:looper_process (noflash)
    inst_player:RHY (noflash)
    inst_song:PX_SCALES (noflash)
