# Generated by tools/iram_lf.py from the audio path's entry points: instrument:audio front:front_audio
# 3 functions (14049 bytes of code to IRAM), 2 tables (388 bytes to DRAM); functions marked
# IRAM_ATTR are there already. Rebuild, then run it again after changing what the sound calls.
[mapping:huff_audio]
archive: libmain.a
entries:
    instrument:audio (noflash)
    instrument:voice_run (noflash)
    looper:looper_process (noflash)
    instrument:esync_beats (noflash)
    instrument:models (noflash)
